# ── Super Admin (seeded on first boot)
SUPER_ADMIN_EMAIL=superadmin@onesol.com
SUPER_ADMIN_PASSWORD=Admin@123
SUPER_ADMIN_NAME=Super Admin

# ── Server
PORT=3000
BASE_URL=http://localhost:3000

